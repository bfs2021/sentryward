generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

// Instance-wide role. Admins manage who can use this Sentryward install; it grants
// no access to other users' repositories or reviews.
enum InstanceRole {
  admin
  member

  @@map("instance_role")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique @db.Citext
  passwordHash    String       @map("password_hash")
  role            InstanceRole @default(member)
  // Carried in every session token; bumping it signs out all existing sessions.
  sessionVersion  Int          @default(0) @map("session_version")
  // Set while the user has a profile picture; also its cache-busting version.
  avatarUpdatedAt DateTime?    @map("avatar_updated_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  avatar             UserAvatar?
  personalWorkspace  Workspace?        @relation("PersonalWorkspace")
  memberships        Membership[]
  connectionsCreated ForgeConnection[]
  invitesSent        Invite[]
  oauthStates        OAuthState[]
  passwordResets     PasswordReset[]   @relation("PasswordResetUser")
  passwordResetsMade PasswordReset[]   @relation("PasswordResetCreator")
  apiTokens          ApiToken[]

  @@map("users")
}

// Kept apart from users so listing users never loads image bytes. The browser
// uploads an already cropped and downsized image.
model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  data      Bytes
  mimeType  String   @map("mime_type")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// Owns connections (and through them repositories, reviews and findings), LLM
// credentials and the global review config. Every user has a personal one, so
// a solo user never sees the difference.
model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  // Set only on a user's personal workspace: at most one each, deleted with them.
  personalOwnerId String?  @unique @map("personal_owner_id") @db.Uuid
  // Global review config: a ConfigOverride applied to every repository that
  // follows it (and beneath the overrides of those that do not).
  reviewSettings  Json     @default("{}") @map("review_settings")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  personalOwner  User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  connections    ForgeConnection[]
  llmCredentials LlmCredential[]
  invites        Invite[]
  oauthStates    OAuthState[]
  notifications  NotificationTarget[]

  @@map("workspaces")
}

// Declared most privileged first.
enum WorkspaceRole {
  owner
  admin
  member

  @@map("workspace_role")
}

model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

// A one-time link to register, or with a workspace, to join it (registering
// first if needed). Only a hash of the token is stored, so a database read does
// not yield usable links.
model Invite {
  id          String         @id @default(uuid()) @db.Uuid
  tokenHash   String         @unique @map("token_hash")
  // When set, only this address can use the invite.
  email       String?        @db.Citext
  workspaceId String?        @map("workspace_id") @db.Uuid
  // The role granted on joining; set exactly when workspaceId is.
  role        WorkspaceRole?
  invitedById String?        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  invitedBy User?      @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invites")
}

// A single-use link to set a new password, emailed on request or created by an
// admin to hand over. Like invites, only the token's hash is stored.
model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id") @db.Uuid
  // Set when an admin created the link rather than the user requesting it.
  createdById String?   @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PasswordResetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_resets")
}

// A personal token for scripts and CI, sent as a bearer token. It acts as its
// user; only the hash is stored, and the value is shown once on creation.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  // Null for a token that never expires.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

enum ForgeProvider {
  github
  gitlab

  @@map("forge_provider")
}

enum ConnectionKind {
  github_app
  token
  // GitLab OAuth: the access token in encrypted_token expires and is renewed
  // with encrypted_refresh_token.
  oauth

  @@map("connection_kind")
}

enum ReviewTrigger {
  manual
  webhook
  comment

  @@map("review_trigger")
}

enum ReviewStatus {
  queued
  running
  completed
  partial
  failed
  superseded
  // The trigger did not call for a review (auto-review off, a draft).
  skipped
  // The PR/MR was closed or merged before the review finished.
  cancelled

  @@map("review_status")
}

enum ReviewVerdict {
  pass
  blocked
  error

  @@map("review_verdict")
}

enum FindingState {
  open
  resolved
  ignored

  @@map("finding_state")
}

// How a finding stands against the change's latest run: first reported by it,
// reported earlier and still there, back after an earlier run resolved it, or
// gone. A gone finding is either fixed or invalidated (its code was renamed,
// moved or removed, so it no longer applies but was not fixed); both have
// state resolved.
enum FindingLifecycle {
  new
  still_open
  reopened
  fixed
  invalidated

  @@map("finding_lifecycle")
}

// Declared most severe first: Postgres orders an enum by declaration, so the
// findings list can sort by rank.
enum FindingSeverity {
  critical
  major
  minor
  info

  @@map("finding_severity")
}

// Why the user dismissed a finding, chosen when ignoring it.
enum IgnoreReason {
  false_positive
  intentional
  fix_later
  not_specified

  @@map("ignore_reason")
}

model ForgeConnection {
  id                    String         @id @default(uuid()) @db.Uuid
  workspaceId           String         @map("workspace_id") @db.Uuid
  // Who connected it, for display; the workspace owns it.
  createdById           String?        @map("created_by_id") @db.Uuid
  provider              ForgeProvider
  host                  String
  kind                  ConnectionKind
  installationId        String?        @map("installation_id")
  encryptedToken        String?        @map("encrypted_token")
  // OAuth connections only. GitLab rotates the refresh token on every use.
  encryptedRefreshToken String?        @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime?      @map("token_expires_at") @db.Timestamptz
  accountLogin          String         @map("account_login")
  // GitHub App connections only: the installed account's id, which survives
  // a rename where accountLogin does not. Matches a reinstall to this row.
  accountId             String?        @map("account_id")
  // Token and OAuth connections only: when the forge last refused the stored
  // credentials. While set, repository hooks queue nothing; reconnecting the
  // account or a passing status check clears it.
  credentialsRejectedAt DateTime?      @map("credentials_rejected_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  repositories Repository[]

  // Several detached (null) rows may coexist; an installation is saved once.
  @@unique([workspaceId, installationId])
  @@index([workspaceId])
  @@map("forge_connections")
}

// An OAuth round trip in progress. The id is the `state` sent to the forge; the
// callback deletes the row to use it, so a state works once.
model OAuthState {
  id           String   @id
  userId       String   @map("user_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  host         String
  // PKCE code verifier, sent with the code exchange.
  codeVerifier String   @map("code_verifier")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("oauth_states")
}

model Repository {
  id                     String        @id @default(uuid()) @db.Uuid
  connectionId           String        @map("connection_id") @db.Uuid
  provider               ForgeProvider
  host                   String
  fullPath               String        @map("full_path")
  externalId             String        @map("external_id")
  defaultBranch          String        @map("default_branch")
  enabled                Boolean       @default(false)
  // Set when the forge took the app's access away (and disabled the repo), as
  // opposed to a user disabling it. Only these come back on their own.
  accessLostAt           DateTime?     @map("access_lost_at") @db.Timestamptz
  settings               Json          @default("{}")
  // When set, `settings` is ignored and only the workspace's global config applies.
  followGlobal           Boolean       @default(true) @map("follow_global")
  // GitLab project hook Sentryward registered, and the secret GitLab sends with it.
  webhookId              String?       @map("webhook_id")
  encryptedWebhookSecret String?       @map("encrypted_webhook_secret")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  connection     ForgeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviewJobs     ReviewJob[]
  postedFindings PostedFinding[]
  findings       Finding[]
  threadReplies  ThreadReply[]

  @@unique([connectionId, externalId])
  // Trigram index for the reviews search, which matches the path anywhere and
  // ignores case (ILIKE '%q%'), so a btree index cannot serve it.
  @@index([fullPath(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("repositories")
}

model ReviewJob {
  id              String         @id @default(uuid()) @db.Uuid
  repositoryId    String         @map("repository_id") @db.Uuid
  number          Int
  headSha         String         @map("head_sha")
  baseSha         String?        @map("base_sha")
  trigger         ReviewTrigger
  // For webhook jobs, whether the change was opened ("open") or received new
  // commits ("push"); trigger settings treat the two differently.
  event           String?
  // Forge login of whoever opened, pushed or commented, for the author skip list.
  actor           String?
  status          ReviewStatus   @default(queued)
  verdict         ReviewVerdict?
  resolvedConfig  Json?          @map("resolved_config")
  result          Json?
  // Small digest of the result (title, counts) so lists never load results.
  summary         Json?
  // The change's title, copied out because JSON string matching cannot ignore
  // case and the reviews search must. Written when the worker fetches the
  // change, so skipped and cancelled runs have it too. The migration that added
  // it backfills in one UPDATE: a migration cannot commit between batches, and
  // retention keeps the table small enough for one pass at startup.
  title           String?
  // What was posted to the forge: inline comments, summary, commit status.
  publication     Json?
  error           String?
  attempts        Int            @default(0)
  lockedAt        DateTime?      @map("locked_at") @db.Timestamptz
  startedAt       DateTime?      @map("started_at") @db.Timestamptz
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz
  // Claimed before notification targets are sent to, so a job finished by
  // both its run and stale recovery notifies once.
  notifiedAt      DateTime?      @map("notified_at") @db.Timestamptz
  // Set when REVIEW_RETENTION_DAYS cleared result, resolvedConfig and
  // publication, so an expired result reads differently from a run that never
  // stored one.
  resultExpiredAt DateTime?      @map("result_expired_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings   Finding[]

  @@index([status, createdAt])
  @@index([status, finishedAt])
  @@index([repositoryId, number])
  // Same reason as the repository path index: the search is ILIKE '%q%'.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("review_jobs")
}

model PostedFinding {
  id             String   @id @default(uuid()) @db.Uuid
  repositoryId   String   @map("repository_id") @db.Uuid
  number         Int
  fingerprint    String
  forgeCommentId String   @map("forge_comment_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number, fingerprint])
  @@map("posted_findings")
}

// One finding on one pull/merge request across all its runs, keyed like
// PostedFinding. The worker keeps it in step with each run's result (open while
// a run still reports it, resolved once a run that read its file does not);
// "ignored" is only ever set by the user and survives later runs.
model Finding {
  id           String          @id @default(uuid()) @db.Uuid
  repositoryId String          @map("repository_id") @db.Uuid
  number       Int
  fingerprint  String
  state        FindingState    @default(open)
  lifecycle    FindingLifecycle @default(new)
  // Snapshot from the latest run that reported it, so lists never load results.
  title        String
  file         String
  startLine    Int             @map("start_line")
  // Null on rows recorded before it was kept.
  endLine      Int?            @map("end_line")
  severity     FindingSeverity
  category     String
  kind         String
  changeTitle  String          @map("change_title")
  // Forge login of whoever opened the change; unknown for backfilled rows.
  author       String?
  // The model of the review pass that raised it, for the false-positive
  // breakdown. Null for tool and rule findings and rows nothing could be
  // backfilled for. Frozen with lastJobId while ignored, so a dismissal stays
  // with the model and run that were dismissed.
  model        String?
  lastJobId    String?         @map("last_job_id") @db.Uuid
  firstSeenAt  DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz
  ignoredAt    DateTime?       @map("ignored_at") @db.Timestamptz
  // Set together with ignoredAt and cleared on reopen.
  ignoreReason IgnoreReason?   @map("ignore_reason")
  ignoreNote   String?         @map("ignore_note")
  // The forge thread could not be moved to match `state` (a failed resolve or
  // reopen). Later runs retry it until the forge agrees.
  threadPending Boolean        @default(false) @map("thread_pending")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  lastJob    ReviewJob? @relation(fields: [lastJobId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, number, fingerprint])
  @@index([repositoryId, state])
  @@index([repositoryId, lifecycle])
  @@map("findings")
}

// What a reply on one of Sentryward's inline threads asked for.
enum ThreadReplyKind {
  ignore
  question

  @@map("thread_reply_kind")
}

enum ThreadReplyStatus {
  queued
  running
  done
  skipped
  failed

  @@map("thread_reply_status")
}

// A person's reply on an inline finding thread, recorded by the webhook and
// answered by the worker, so model latency and forge calls stay out of the
// webhook. Unique on the forge comment so a redelivered event is a no-op, and
// the rows double as the per-change rate limit.
model ThreadReply {
  id              String            @id @default(uuid()) @db.Uuid
  repositoryId    String            @map("repository_id") @db.Uuid
  number          Int
  fingerprint     String
  // GitHub: the thread's root comment id. GitLab: the discussion id.
  threadId        String            @map("thread_id")
  commentId       String            @map("comment_id")
  actor           String
  kind            ThreadReplyKind
  // The reply text as written: untrusted, only ever sent to a model as data.
  body            String
  // Ignore commands only; null with kind ignore means the reason was not understood.
  ignoreReason    IgnoreReason?     @map("ignore_reason")
  ignoreNote      String?           @map("ignore_note")
  status          ThreadReplyStatus @default(queued)
  answerCommentId String?           @map("answer_comment_id")
  error           String?
  attempts        Int               @default(0)
  lockedAt        DateTime?         @map("locked_at") @db.Timestamptz
  finishedAt      DateTime?         @map("finished_at") @db.Timestamptz
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, commentId])
  @@index([repositoryId, number, createdAt])
  @@index([status, createdAt])
  @@map("thread_replies")
}

model LlmCredential {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  provider     String
  encryptedKey String?  @map("encrypted_key")
  baseUrl      String?  @map("base_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("llm_credentials")
}

enum NotificationKind {
  webhook
  slack
  email

  @@map("notification_kind")
}

enum NotificationEvent {
  blocked
  failed
  completed

  @@map("notification_event")
}

// Where the worker reports finished reviews. URLs are encrypted: a Slack
// incoming-webhook URL is itself the credential. A webhook target signs its
// payloads with `encryptedSecret`; an email target mails `recipientIds`, and
// only those still members of the workspace.
model NotificationTarget {
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  kind            NotificationKind
  name            String
  events          NotificationEvent[]
  encryptedUrl    String?             @map("encrypted_url")
  encryptedSecret String?             @map("encrypted_secret")
  recipientIds    String[]            @default([]) @map("recipient_ids") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("notification_targets")
}
