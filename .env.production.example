# Production settings for docker-compose.prod.yml. See "Deploying" in the README.
# Copy to .env.production, fill in every value marked required, and keep the
# file out of version control.

# Pin a release tag. "latest" follows stable releases only, not alpha releases.
SENTRYWARD_VERSION=0.2.0

# Database (required: POSTGRES_PASSWORD). Generate with: openssl rand -hex 24
POSTGRES_USER=sentryward
POSTGRES_PASSWORD=
POSTGRES_DB=sentryward

# Required. Generate each with: openssl rand -hex 32
JWT_SECRET=
# Encrypts forge tokens and LLM keys at rest. Keep it stable and back it up
# separately: changing it makes stored credentials unreadable.
ENCRYPTION_KEY=

# Required. The public HTTPS URL of this instance, used for both: the API
# serves the dashboard, so they share one origin.
CLIENT_ORIGIN=https://sentryward.example.com
API_PUBLIC_URL=https://sentryward.example.com

# Reverse proxy hops in front of the API (1 for a single proxy).
TRUST_PROXY=1
# Port the API listens on, on the host's loopback interface by default.
API_HOST_PORT=4000
API_BIND=127.0.0.1

# Who can create an account: open, invite (invite links only) or closed.
# The first account is always allowed and becomes the instance admin.
REGISTRATION_MODE=invite
# Optional SMTP transport for invite emails, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=

# GitHub App (optional; GitHub connections are disabled without it). See README.
GITHUB_HOST=github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The app's private key on one line, newlines written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# GitLab OAuth application (optional). Redirect URI:
# <CLIENT_ORIGIN>/api/connections/gitlab/oauth/callback. See README.
GITLAB_OAUTH_HOST=gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Model keys used by the worker when a user has not stored their own (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Review worker (optional; the values shown are the defaults).
# How often to poll for queued reviews, and how many run at once.
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
# Reviews one workspace may have running at once.
WORKER_USER_CONCURRENCY=2
# A review whose worker has gone silent this long is treated as abandoned and
# retried, up to WORKER_MAX_ATTEMPTS attempts in total. 900000 is 15 minutes.
WORKER_LOCK_TIMEOUT_MS=900000
WORKER_MAX_ATTEMPTS=3
# A running worker refreshes its lock this often; must be below the lock timeout.
WORKER_HEARTBEAT_INTERVAL_MS=60000
# The longest a review may take before it is failed. 1800000 is 30 minutes.
WORKER_MAX_RUN_MS=1800000
# How long a stop or upgrade waits for in-flight reviews before killing them.
# Keep it above your typical review duration and no higher than the lock timeout.
WORKER_STOP_GRACE_PERIOD=15m
