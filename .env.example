# Database
POSTGRES_USER=sentryward
POSTGRES_PASSWORD=sentryward
POSTGRES_DB=sentryward

# API
# API and worker runtime behavior: development or production.
# production requires HTTPS; this does not make the Docker setup production-ready.
NODE_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Must match the URL you open the client on
CLIENT_ORIGIN=http://localhost:5173
# Encrypts forge tokens and LLM keys at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# GitHub App (optional; GitHub connections are disabled without it). See README.
GITHUB_HOST=github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The app's private key on one line, newlines written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The secret set on the GitHub App's webhook
GITHUB_WEBHOOK_SECRET=

# GitLab OAuth application (optional; GitLab connects with access tokens without it).
# Redirect URI: <CLIENT_ORIGIN>/api/connections/gitlab/oauth/callback, scope api,
# Confidential and Expire access tokens on. See README.
GITLAB_OAUTH_HOST=gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Public URL of the API, registered as the webhook URL on GitLab projects
API_PUBLIC_URL=http://localhost:4000

# Who can create an account: open, invite (invite links only) or closed.
# The first account is always allowed and becomes the instance admin.
REGISTRATION_MODE=open
# Optional SMTP transport for invite emails; without it, copy the invite link.
# Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=

# Model keys used by the worker when a user has not stored their own (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Worker runtime (optional; sensible defaults shown). The worker refreshes a
# running job's lock every WORKER_HEARTBEAT_INTERVAL_MS so a long-but-healthy
# review is not reclaimed as a dead worker; it must be below
# WORKER_LOCK_TIMEOUT_MS (default 900000, 15m) or the server will not start.
# WORKER_MAX_RUN_MS is the longest a review may take: a run past it is failed,
# healthy or not, so raise it for repositories with very large reviews.
# WORKER_HEARTBEAT_INTERVAL_MS=60000
# WORKER_MAX_RUN_MS=1800000

# Review retention (optional; unset keeps everything). Once a day count is set,
# the worker hourly deletes older superseded, skipped and cancelled reviews and
# clears the full result of older finished ones, keeping their summary.
# REVIEW_RETENTION_DAYS=90

# Host ports (change if already in use on your machine)
DB_HOST_PORT=5433
API_HOST_PORT=4000
CLIENT_HOST_PORT=5173
